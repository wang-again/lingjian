# npm start / 启动工作台.cmd 自动读取项目根目录 .env。复制本文件为 .env 后修改。
# 默认即可本机运行：单机模式、仅监听 127.0.0.1。所有项都有默认值，不建 .env 也能启动。
# local：不登录，直接用；只适合一个人在自己电脑上使用。
# accounts：需要注册和登录，文档、文件与模型配置按账号隔离；多人或共用电脑时选它。
LINGJIAN_AUTH_MODE=local
HOST=127.0.0.1
PORT=3210

# 可选：指定已安装的同版本 Electron 运行时所在目录。
# ELECTRON_OVERRIDE_DIST_PATH=C:/path/to/electron

# 可选：Office/OCR 的 Python 解释器绝对路径。
# 默认使用项目内 .venv-office（Windows: Scripts/python.exe；Linux: bin/python）。
# OFFICE_PYTHON=D:/path/to/project/.venv-office/Scripts/python.exe

# 可选：单独安装的 office-tool 源码目录（包含 server.py）。默认 .vendor/office-tool。
# OFFICE_TOOL_DIR=D:/path/to/office-tool

# 可选：本机运行保持留空。仅在把服务暴露到本机以外时才需要填 HTTPS 站点来源。
APP_ORIGIN=

# 可选：仅在 LINGJIAN_AUTH_MODE=accounts 时生效。
# 允许在登录页注册新账号，便于本机多账号隔离；不需要时改为 0。
ALLOW_REGISTRATION=1
# 本机运行可留空；设置 APP_ORIGIN 对外开放注册时必须填写强随机邀请码。
REGISTRATION_INVITE_CODE=

# 可选：仅在 LINGJIAN_AUTH_MODE=accounts 时生效，允许用户勾选“记住密钥”。
# 留空则密钥只保存在会话内存。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 单独备份此主密钥，勿提交代码仓库或与数据备份混放。更换后旧密钥须重填。
LINGJIAN_KEY_ENCRYPTION_KEY=

# 可选：默认已允许五家预设及 OpenAI、百炼国际站。
# 额外 API 域名逗号分隔，不加协议/路径/通配符。
MODEL_ALLOWED_HOSTS=
